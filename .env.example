# MusiX configuration — copy to `.env` and fill in the blanks:
#   cp .env.example .env
# docker-compose.yml reads `.env` automatically. `.env` is gitignored; this
# template (.env.example) is safe to commit.

# ── Qdrant ──────────────────────────────────────────────────────────────────
# Inside the Compose network the app reaches Qdrant by its service name.
# Leave this as-is for Docker; for a bare-metal run use http://localhost:6333.
QDRANT_URL=http://qdrant:6333

# ── SearXNG (local metasearch used for AI web research) ─────────────────────
# Inside the Compose network the app reaches SearXNG by its service name + the
# INTERNAL port (8080) — the host-published localhost:8088 is NOT visible from
# the container. Leave as-is for Docker; for a bare-metal run use
# http://localhost:8088. Falls back to DuckDuckGo if unreachable.
SEARXNG_URL=http://searxng:8080

# ── Auth (REQUIRED for production) ──────────────────────────────────────────
# 32+ random chars. If unset, the app boots with an insecure dev fallback and
# logs a loud warning. Generate one with:  openssl rand -hex 32
MUSIX_JWT_SECRET=

# ── Public base URL (for invite links) ──────────────────────────────────────
# The absolute base the admin's invite links are built from. Set this to the
# address members reach the server at — important behind a reverse proxy / when
# exposed to the internet under a domain (the admin's browser origin is the LAN
# address and would produce links members can't open).
#   PUBLIC_BASE_URL=https://music.example.com
# If unset, links fall back to this machine's LAN IP, e.g.
# http://192.168.0.168:8000. The port for that fallback comes from APP_PORT
# (then PORT), default 8000.
# PUBLIC_BASE_URL=
# APP_PORT=8000

# ── LLM — external OpenAI-compatible API ────────────────────────────────────
# Powers AI chat + fact enrichment. Without these, search/streaming still work
# but AI features stay disabled.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# The text embedding model is not configurable: one model app-wide, pinned in
# app/resources/model_registry.py (TEXT_MODEL_NAME). Changing it means
# re-embedding every collection — see scripts/migrate_dense.py.

# ── Optional tuning ─────────────────────────────────────────────────────────
# MUSIX_MAX_UPLOAD_MB=200
# MAX_PARALLEL_INDEXING_JOBS=2

# ── Yandex Music import (server mode) ───────────────────────────────────────
# Fernet key (urlsafe-base64 of 32 bytes) used to encrypt the per-account Yandex
# OAuth token at rest. If unset, a key is derived from MUSIX_JWT_SECRET — fine
# for most setups; set this only to rotate token encryption independently.
# Generate one with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# MUSIX_YM_TOKEN_KEY=
# Auto-fill empty track metadata (album/year/genre) from the Yandex catalog
# during indexing (folder + upload + import). Default on; set 0 to disable.
# MUSIX_YM_ENRICH=1
# Force CPU inference even if a CUDA GPU is present. Accepts 1/true/yes/on.
# Leave unset to auto-detect CUDA and fall back to CPU.
# FORCE_CPU=1

# ── Ceiling on folder-index grants (server mode) ────────────────────────────
# Folder indexing is a PER-ACCOUNT grant (users.index_root), handed out by the
# owner in the admin panel: Members → "source" → grant a path. An account with
# a grant may index that folder and anything beneath it and rescan it on demand;
# an account without one may not index a host path at all and is never told the
# path exists.
#
# MEMBER_INDEX_ROOT no longer GRANTS anything — it only CONFINES what the owner
# is allowed to grant, so a mistyped "/" in the admin panel cannot pour the whole
# host filesystem into someone's library. Unset = no ceiling.
#
# (It used to grant: setting it let EVERY member index that root — i.e. clone
# another account's by-reference library — and the path was published through
# the unauthenticated GET /instance/config.)
# MEMBER_INDEX_ROOT=/music

# ── Where the by-reference music library lives ON THE HOST ──────────────────
# Consumed by docker-compose(.prod).yml for the "<host>:/music" bind mount.
# Unset = /mnt/music (the historical default), so existing setups keep working.
# Only the HOST side is configurable: the container side stays /music because it
# is baked into file_path in Qdrant payloads and track_metadata.file_path —
# changing it would require re-indexing the whole library.
# MUSIX_MUSIC_DIR=/mnt/data/music

# ── Keeping SQLite off a slow disk ──────────────────────────────────────────
# metadata.db takes a write on every playback event, reaction and history row —
# exactly the random-write pattern that SMR hard drives are worst at. If the
# project directory sits on an HDD, point these at an SSD instead. Both must be
# set together: MUSIX_DB_DIR is the HOST directory bound at /app/dbstore, and
# MUSIX_METADATA_DB is where the app looks for the file inside the container.
# Leave both unset to keep the DB in cache/metadata.db as before.
# MUSIX_DB_DIR=/home/you/musix-db
# MUSIX_METADATA_DB=/app/dbstore/metadata.db

# ── HTTP Proxy (optional) ───────────────────────────────────────────────────
# When set, EXTERNAL outbound requests during indexing (artist facts / song
# facts, AudioDB bios + images, and external web pages fetched for AI bio
# generation) route through this proxy. Lyrics fetching and local services
# (SearXNG, Qdrant, the local LLM) always go direct.
# Supports standard proxy URL format with optional auth; HTTPS_PROXY is accepted
# as an alternative key:
#   HTTP_PROXY=http://user:pass@proxy.example.com:8080
# Leave empty/unset to use direct network connections.
# HTTP_PROXY=

# ── Model endpoints for OTHER services (optional) ───────────────────────────
# MusiX can expose its three text models — Octen (dense), MILCO (learned
# sparse) and bge-reranker-v2-m3 — over HTTP under /api/v1/models, so a RAG
# service you build separately reuses THESE weights instead of loading its own.
# Three residents are ~3.5 GB of VRAM on a card already shared with an LLM; a
# second copy is not affordable.
#
# The caller is a service, not an account, so these routes take a static bearer
# token instead of the account JWT. UNSET = the routes refuse everything with
# 503: an open model endpoint is not a sensible default, even on a
# loopback-only deployment.
#   curl -H "Authorization: Bearer $MUSIX_MODELS_TOKEN" \
#        http://127.0.0.1:8000/api/v1/models/v1/models
# An OpenAI client points its base_url at .../api/v1/models/v1 and asks for
# model "octen-query" or "octen-document" — the two sides of one asymmetric
# model, over one set of weights. Using one for both is a quiet recall loss.
#   openssl rand -hex 32
MUSIX_MODELS_TOKEN=
