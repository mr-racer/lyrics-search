# MusiX configuration — copy to `.env` and fill in the blanks:
#   cp .env.example .env
# docker-compose.yml reads `.env` automatically. `.env` is gitignored; this
# template (.env.example) is safe to commit.

# ── Qdrant ──────────────────────────────────────────────────────────────────
# Inside the Compose network the app reaches Qdrant by its service name.
# Leave this as-is for Docker; for a bare-metal run use http://localhost:6333.
QDRANT_URL=http://qdrant:6333

# ── Auth (REQUIRED for production) ──────────────────────────────────────────
# 32+ random chars. If unset, the app boots with an insecure dev fallback and
# logs a loud warning. Generate one with:  openssl rand -hex 32
MUSIX_JWT_SECRET=

# ── LLM — external OpenAI-compatible API ────────────────────────────────────
# Powers AI chat + fact enrichment. Without these, search/streaming still work
# but AI features stay disabled.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ── Embedding models (defaults are fine) ────────────────────────────────────
TEXT_MODEL=jinaai/jina-embeddings-v2-small-en

# ── Optional tuning ─────────────────────────────────────────────────────────
# MUSIX_MAX_UPLOAD_MB=200
# MAX_PARALLEL_INDEXING_JOBS=2

# ── HTTP Proxy (optional) ───────────────────────────────────────────────────
# When set, EXTERNAL outbound requests during indexing (artist facts / song
# facts, AudioDB bios + images, and external web pages fetched for AI bio
# generation) route through this proxy. Lyrics fetching and local services
# (SearXNG, Qdrant, the local LLM) always go direct.
# Supports standard proxy URL format with optional auth; HTTPS_PROXY is accepted
# as an alternative key:
#   HTTP_PROXY=http://user:pass@proxy.example.com:8080
# Leave empty/unset to use direct network connections.
# HTTP_PROXY=
